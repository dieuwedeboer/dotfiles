#!/usr/bin/env bash
# Install, update, and Steam-launch M2EX for Medieval II: Total War.
set -euo pipefail

VANILLA_APP_ID=4700
REPO="Pannoniae/rex"
ASSET_NAME="M2EX.7z"
EXE_NAME="M2EX.exe"
SHORTCUT_NAME="M2EX"
PROTON_TOOL="${M2EX_PROTON:-proton-cachyos-slr}"

script_path() {
    readlink -f "${BASH_SOURCE[0]}"
}

launch_wrapper() {
    printf '%s %%command%%\n' "$(script_path)"
}

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/m2ex"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/m2ex"
RELEASES_URL="https://api.github.com/repos/${REPO}/releases"
USER_AGENT="m2ex-updater (+https://github.com/${REPO})"
GAME_DIR=""
EXE_PATH=""
VERSION_FILE=""

if [[ -n "${STEAM_DIR:-}" ]]; then
    STEAM_ROOT="$STEAM_DIR"
elif [[ -e "$HOME/.steam/steam" ]]; then
    STEAM_ROOT="$(readlink -f "$HOME/.steam/steam")"
else
    STEAM_ROOT="$HOME/.local/share/Steam"
fi

usage() {
    cat <<'EOF'
Usage: m2ex <command> [args]
       m2ex %command%

Commands:
  check         Compare the installed build with the latest GitHub test release
  update        Install the latest test release if it is newer
  update --force
                Reinstall even if the tag matches
  status        Show install path, version, shortcut, and prefix
  hook-steam    Add M2EX as a non-Steam game, force Proton, install vcrun2022
  unhook-steam  Remove the M2EX shortcut and restore vanilla Medieval II
  setup-prefix  Create the Proton prefix and install vcrun2022
  launch [mod]  Start M2EX through Steam (vanilla, americas, britannia,
                crusades, teutonic)
  help          Show this help

Linux install follows the REX/M2EX guide: Windows Steam depot + Proton,
M2EX.exe as a non-Steam shortcut, then vcrun2022 in that prefix.

The game directory is read from Steam's libraryfolders.vdf for app 4700.
Updates prefer GitHub prereleases (test builds). If none are published,
the newest normal release is used. Discord-only test drops are not
scraped automatically.

Environment:
  M2EX_GAME_DIR      Override the game install path
  M2EX_PROTON        Compatibility tool name (default proton-cachyos-slr)
  STEAM_DIR          Override the Steam root
  M2EX_SKIP_UPDATE=1 Skip the GitHub check when wrapping a Steam launch
EOF
}

log() { printf 'm2ex: %s\n' "$*"; }
warn() { printf 'm2ex: warning: %s\n' "$*" >&2; }
die() { printf 'm2ex: %s\n' "$*" >&2; exit 1; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

discover_game_dir() {
    local libfile="$STEAM_ROOT/steamapps/libraryfolders.vdf"
    [[ -f "$libfile" ]] || die "Steam library list not found at $libfile"
    python3 - "$STEAM_ROOT" "$VANILLA_APP_ID" <<'PY'
import sys
from pathlib import Path
import vdf

steam_root = Path(sys.argv[1])
appid = str(sys.argv[2])
libfile = steam_root / "steamapps" / "libraryfolders.vdf"
data = vdf.loads(libfile.read_text(errors="replace"))
folders = data.get("libraryfolders") or {}
found = None
for folder in folders.values():
    if not isinstance(folder, dict):
        continue
    path = folder.get("path")
    if not path:
        continue
    lib = Path(path)
    apps = {str(k) for k in (folder.get("apps") or {})}
    acf = lib / "steamapps" / f"appmanifest_{appid}.acf"
    if appid in apps or acf.exists():
        found = lib
        break
if found is None:
    sys.exit(2)
acf = found / "steamapps" / f"appmanifest_{appid}.acf"
installdir = "Medieval II Total War"
if acf.exists():
    state = vdf.loads(acf.read_text(errors="replace"))
    installdir = state.get("AppState", {}).get("installdir") or installdir
print(found / "steamapps" / "common" / installdir)
PY
}

resolve_paths() {
    if [[ -n "$GAME_DIR" ]]; then
        return 0
    fi
    if [[ -n "${M2EX_GAME_DIR:-}" ]]; then
        GAME_DIR="$M2EX_GAME_DIR"
    else
        local discovered
        if ! discovered="$(discover_game_dir)"; then
            die "Medieval II (app $VANILLA_APP_ID) is not in any Steam library. Install it or set M2EX_GAME_DIR."
        fi
        GAME_DIR="$discovered"
    fi
    EXE_PATH="$GAME_DIR/$EXE_NAME"
    VERSION_FILE="$GAME_DIR/m2ex.version"
}

installed_tag() {
    if [[ -f "$VERSION_FILE" ]]; then
        tr -d '[:space:]' <"$VERSION_FILE"
    fi
}

game_ready() {
    [[ -d "$GAME_DIR" && -f "$GAME_DIR/medieval2.exe" ]]
}

m2ex_installed() {
    [[ -f "$EXE_PATH" ]]
}

cache_name_for_tag() {
    local tag="$1"
    printf 'M2EX-%s.7z' "${tag//\//-}"
}

userdata_dir() {
    local cfg
    cfg="$(find_localconfig)"
    dirname "$(dirname "$cfg")"
}

shortcuts_path() {
    printf '%s\n' "$(userdata_dir)/config/shortcuts.vdf"
}

# Quoted exe + name, matching how Steam stores shortcut fields.
shortcut_exe_field() {
    printf '"%s"' "$EXE_PATH"
}

shortcut_appid() {
    python3 - "$EXE_PATH" "$SHORTCUT_NAME" <<'PY'
import sys, zlib
exe = f'"{sys.argv[1]}"'
name = sys.argv[2]
print((zlib.crc32((exe + name).encode()) & 0xffffffff) | 0x80000000)
PY
}

shortcut_runid() {
    python3 - "$(shortcut_appid)" <<'PY'
import sys
print((int(sys.argv[1]) << 32) | 0x02000000)
PY
}

fetch_latest() {
    need_cmd curl
    need_cmd jq
    local json
    json="$(curl -fsSL --max-time 15 -A "$USER_AGENT" "$RELEASES_URL")"
    local chosen
    chosen="$(jq -c --arg n "$ASSET_NAME" '
        def has_asset: ([.assets[].name] | index($n)) != null;
        ( [.[] | select(.draft == false and .prerelease == true and has_asset)] | first )
        // ( [.[] | select(.draft == false and has_asset)] | first )
        // empty
    ' <<<"$json")"
    [[ -n "$chosen" ]] || die "no GitHub release contains $ASSET_NAME"
    local tag url digest size channel
    tag="$(jq -er '.tag_name' <<<"$chosen")"
    url="$(jq -er --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$chosen")"
    digest="$(jq -r --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | (.digest // empty)' <<<"$chosen")"
    size="$(jq -er --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | .size' <<<"$chosen")"
    if [[ "$(jq -er '.prerelease' <<<"$chosen")" == "true" ]]; then
        channel="test"
    else
        channel="stable"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$tag" "$url" "$digest" "$size" "$channel"
}

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

verify_digest() {
    local file="$1" digest="$2"
    [[ -z "$digest" || "$digest" == "null" ]] && return 0
    local expected="${digest#sha256:}"
    local actual
    actual="$(sha256_file "$file")"
    [[ "$actual" == "$expected" ]]
}

download_asset() {
    local url="$1" dest="$2" digest="$3"
    mkdir -p "$(dirname "$dest")"
    local tmp="${dest}.part"
    curl -fL --retry 3 --retry-delay 2 -A "$USER_AGENT" -o "$tmp" "$url"
    if ! verify_digest "$tmp" "$digest"; then
        rm -f "$tmp"
        die "checksum mismatch for $ASSET_NAME"
    fi
    mv -f "$tmp" "$dest"
}

extract_archive() {
    local archive="$1"
    need_cmd 7z
    game_ready || die "Medieval II install not found at $GAME_DIR"
    7z x -y -aoa -o"$GAME_DIR" "$archive" >/dev/null
    [[ -f "$EXE_PATH" ]] || die "extract finished but $EXE_NAME is missing"
}

protonfix_path() {
    local appid="${1:-}"
    if [[ -z "$appid" ]]; then
        appid="$(shortcut_appid)"
    fi
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/protonfixes/localfixes/${appid}.py"
}

vanilla_protonfix_path() {
    printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/protonfixes/localfixes/${VANILLA_APP_ID}.py"
}

cmd_status() {
    local tag channel appid
    tag="$(installed_tag)"
    appid="$(shortcut_appid)"
    printf 'Game dir:     %s\n' "$GAME_DIR"
    printf 'Game exe:     %s\n' "$(game_ready && echo present || echo missing)"
    printf 'M2EX exe:     %s\n' "$(m2ex_installed && echo present || echo missing)"
    printf 'Installed:    %s\n' "${tag:-none}"
    printf 'Shortcut:     %s (appid %s)\n' "$SHORTCUT_NAME" "$appid"
    printf 'Launch wrap:  %s\n' "$(launch_wrapper)"
    if [[ -f "$(protonfix_path "$appid")" ]]; then
        printf 'Proton hook:  %s\n' "$(protonfix_path "$appid")"
    else
        printf 'Proton hook:  missing\n'
    fi
    if [[ -f "$(vanilla_protonfix_path)" ]]; then
        printf 'Vanilla hijack: %s (should be absent)\n' "$(vanilla_protonfix_path)"
    fi
    local prefix="$STEAM_ROOT/steamapps/compatdata/$appid"
    if [[ -d "$prefix/pfx" ]]; then
        printf 'Prefix:       %s\n' "$prefix"
    else
        printf 'Prefix:       not created yet\n'
    fi
}

cmd_check() {
    local tag url digest size channel installed
    installed="$(installed_tag)"
    IFS=$'\t' read -r tag url digest size channel <<<"$(fetch_latest)"
    printf 'Installed: %s\n' "${installed:-none}"
    printf 'Latest:    %s (%s)\n' "$tag" "$channel"
    if [[ -n "$installed" && "$installed" == "$tag" ]]; then
        printf 'Status:    up to date\n'
        return 0
    fi
    printf 'Status:    update available\n'
    return 2
}

cmd_update() {
    local force=0
    if [[ "${1:-}" == "--force" ]]; then
        force=1
    elif [[ -n "${1:-}" ]]; then
        die "unknown update option: $1"
    fi

    game_ready || die "Medieval II install not found at $GAME_DIR"

    local tag url digest size channel installed
    installed="$(installed_tag)"
    IFS=$'\t' read -r tag url digest size channel <<<"$(fetch_latest)"
    log "latest GitHub $channel release is $tag"

    if [[ $force -eq 0 && -n "$installed" && "$installed" == "$tag" && -f "$EXE_PATH" ]]; then
        log "already on $tag"
        return 0
    fi

    local archive="$CACHE_DIR/$(cache_name_for_tag "$tag")"
    if [[ -f "$archive" ]] && ! verify_digest "$archive" "$digest"; then
        warn "cached archive failed checksum, re-downloading"
        rm -f "$archive"
    fi
    if [[ ! -f "$archive" ]]; then
        log "downloading $ASSET_NAME ($tag)"
        download_asset "$url" "$archive" "$digest"
    else
        log "using cached $archive"
    fi

    log "installing $tag into $GAME_DIR"
    extract_archive "$archive"
    printf '%s\n' "$tag" >"$VERSION_FILE"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$tag" >"$STATE_DIR/installed"
    log "installed $tag"
}

rewrite_steam_command() {
    local -a out=()
    local arg replaced=0
    for arg in "$@"; do
        local base="${arg##*/}"
        local lower="${base,,}"
        if [[ "$lower" == "medieval2.exe" || "$lower" == "kingdoms.exe" || "$lower" == "m2ex.exe" ]]; then
            local exe="$arg"
            [[ "$lower" != "m2ex.exe" ]] && exe="$EXE_PATH"
            out+=("$exe")
            replaced=1
        else
            out+=("$arg")
        fi
    done
    if [[ $replaced -eq 0 ]]; then
        die "Steam command did not contain M2EX.exe, medieval2.exe, or kingdoms.exe"
    fi
    printf '%s\0' "${out[@]}"
}

maybe_update_for_launch() {
    if [[ "${M2EX_SKIP_UPDATE:-}" == "1" ]]; then
        return 0
    fi
    if ! cmd_update; then
        if m2ex_installed; then
            warn "update failed; launching the installed M2EX"
        else
            die "M2EX is not installed and the update failed"
        fi
    fi
}

cmd_wrap_launch() {
    [[ $# -gt 0 ]] || die "missing Steam command"
    maybe_update_for_launch
    m2ex_installed || die "$EXE_NAME is not installed in $GAME_DIR"

    local -a rewritten=()
    mapfile -d '' -t rewritten < <(rewrite_steam_command "$@")
    exec "${rewritten[@]}"
}

find_localconfig() {
    local found=()
    local p
    for p in "$STEAM_ROOT"/userdata/*/config/localconfig.vdf; do
        [[ -f "$p" ]] && found+=("$p")
    done
    if [[ ${#found[@]} -eq 0 ]]; then
        die "could not find Steam userdata/localconfig.vdf"
    fi
    if [[ ${#found[@]} -gt 1 ]]; then
        warn "multiple Steam userconfigs found; using ${found[0]}"
    fi
    printf '%s\n' "${found[0]}"
}

steam_is_running() {
    local pid
    pid="$(cat "$HOME/.steam/steam.pid" 2>/dev/null || true)"
    if [[ -n "$pid" && -r "/proc/$pid/cmdline" ]]; then
        tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q 'ubuntu12_32/steam'
        return $?
    fi
    return 1
}

wait_for_steam_exit() {
    local i
    for i in $(seq 1 90); do
        steam_is_running || return 0
        sleep 1
    done
    return 1
}

wait_for_steam_start() {
    local i
    for i in $(seq 1 60); do
        steam_is_running && return 0
        sleep 1
    done
    return 1
}

ensure_steam_stopped() {
    if steam_is_running; then
        log "shutting Steam down so shortcut and prefix changes persist"
        steam -shutdown >/dev/null 2>&1 || true
        if ! wait_for_steam_exit; then
            die "Steam is still running; close it and retry"
        fi
        return 0
    fi
    return 1
}

start_steam() {
    log "starting Steam"
    nohup steam >/dev/null 2>&1 &
    disown || true
    wait_for_steam_start || warn "Steam did not come back within 60s"
}

set_vanilla_launch_options() {
    local value="$1"
    local cfg
    cfg="$(find_localconfig)"
    python3 - "$cfg" "$VANILLA_APP_ID" "$value" <<'PY'
import re, sys
from pathlib import Path

cfg = Path(sys.argv[1])
app_id = sys.argv[2]
value = sys.argv[3]
text = cfg.read_text(errors="replace")
pattern = re.compile(
    rf'("{re.escape(app_id)}"\n(?P<indent>\t+){{)(?P<body>.*?)(\n(?P=indent)}})',
    re.S,
)
matches = list(pattern.finditer(text))
app_matches = [
    m for m in matches
    if '"LastPlayed"' in m.group("body")
    or '"LaunchOptions"' in m.group("body")
    or f'"{app_id}_eula_' in m.group("body")
]
if not app_matches:
    sys.exit(0)
m = app_matches[0]
indent = m.group("indent") + "\t"
body = re.sub(r'\n\t+"LaunchOptions"\t+".*?"', "", m.group("body"))
if value:
    body += f'\n{indent}"LaunchOptions"\t\t"{value}"'
new = f'{m.group(1)}{body}{m.group(4)}'
if new == m.group(0):
    sys.exit(0)
cfg.write_text(text[: m.start()] + new + text[m.end() :])
PY
}

set_compat_tool() {
    local appid="$1" tool="$2"
    local cfg="$STEAM_ROOT/config/config.vdf"
    python3 - "$cfg" "$appid" "$tool" <<'PY'
import re, sys
from pathlib import Path

cfg = Path(sys.argv[1])
appid, tool = sys.argv[2], sys.argv[3]
text = cfg.read_text(errors="replace")
if re.search(rf'"{re.escape(appid)}"\s*\n\s*\{{\s*\n\s*"name"\s*"{re.escape(tool)}"', text):
    sys.exit(0)
block = (
    f'\t\t\t\t\t"{appid}"\n'
    f'\t\t\t\t\t{{\n'
    f'\t\t\t\t\t\t"name"\t\t"{tool}"\n'
    f'\t\t\t\t\t\t"config"\t\t""\n'
    f'\t\t\t\t\t\t"priority"\t\t"250"\n'
    f'\t\t\t\t\t}}\n'
)
# Drop any previous mapping for this id, then insert at the mapping start.
text = re.sub(
    rf'\t\t\t\t\t"{re.escape(appid)}"\n\t\t\t\t\t\{{.*?\n\t\t\t\t\t\}}\n',
    "",
    text,
    count=1,
    flags=re.S,
)
text, n = re.subn(
    r'("CompatToolMapping"\n\t\t\t\t\{\n)',
    r'\1' + block,
    text,
    count=1,
)
if n != 1:
    sys.exit("could not find CompatToolMapping in config.vdf")
cfg.write_text(text)
PY
}

write_m2ex_shortcut() {
    local appid wrapper
    appid="$(shortcut_appid)"
    wrapper="$(launch_wrapper)"
    python3 - "$(shortcuts_path)" "$EXE_PATH" "$GAME_DIR" "$SHORTCUT_NAME" "$appid" "$wrapper" <<'PY'
import sys
from pathlib import Path
import vdf

path = Path(sys.argv[1])
exe = sys.argv[2]
start_dir = sys.argv[3].rstrip("/") + "/"
name = sys.argv[4]
appid = int(sys.argv[5])
launch = sys.argv[6]
exe_field = f'"{exe}"'
start_field = f'"{start_dir}"'

if path.exists() and path.stat().st_size:
    data = vdf.binary_loads(path.read_bytes(), raise_on_remaining=False)
else:
    data = {"shortcuts": {}}

shortcuts = data.setdefault("shortcuts", {})
# Normalise keys to strings.
shortcuts = {str(k): v for k, v in shortcuts.items()}

entry = None
entry_key = None
for key, item in shortcuts.items():
    lower = {str(k).lower(): v for k, v in item.items()}
    if lower.get("appname") == name or lower.get("exe") == exe_field:
        entry = item
        entry_key = key
        break
if entry is None:
    idx = 0
    while str(idx) in shortcuts:
        idx += 1
    entry_key = str(idx)
    entry = {}
    shortcuts[entry_key] = entry

# Steam stores the high bit as a negative int32.
appid_stored = appid - (1 << 32) if appid >= 1 << 31 else appid
entry["appid"] = appid_stored
entry["AppName"] = name
entry["Exe"] = exe_field
entry["StartDir"] = start_field
entry["icon"] = entry.get("icon", "")
entry["ShortcutPath"] = ""
entry["LaunchOptions"] = launch
entry["IsHidden"] = 0
entry["AllowDesktopConfig"] = 1
entry["AllowOverlay"] = 1
entry["OpenVR"] = 0
entry["Devkit"] = 0
entry["DevkitGameID"] = ""
entry["LastPlayTime"] = int(entry.get("LastPlayTime") or 0)
entry["FlatpakAppID"] = ""
entry.setdefault("tags", {})

path.parent.mkdir(parents=True, exist_ok=True)
path.write_bytes(vdf.binary_dumps({"shortcuts": shortcuts}))
print(appid)
PY
}

remove_m2ex_shortcut() {
    local path
    path="$(shortcuts_path)"
    [[ -f "$path" ]] || return 0
    python3 - "$path" "$SHORTCUT_NAME" "$EXE_PATH" <<'PY'
import sys
from pathlib import Path
import vdf

path = Path(sys.argv[1])
name, exe = sys.argv[2], sys.argv[3]
exe_field = f'"{exe}"'
if not path.exists() or path.stat().st_size == 0:
    sys.exit(0)
data = vdf.binary_loads(path.read_bytes(), raise_on_remaining=False)
shortcuts = {str(k): v for k, v in data.get("shortcuts", {}).items()}
keep = {}
idx = 0
for item in shortcuts.values():
    lower = {str(k).lower(): v for k, v in item.items()}
    if lower.get("appname") == name or lower.get("exe") == exe_field:
        continue
    keep[str(idx)] = item
    idx += 1
path.write_bytes(vdf.binary_dumps({"shortcuts": keep}))
PY
}

install_protonfix() {
    local appid dest
    appid="$(shortcut_appid)"
    dest="$(protonfix_path "$appid")"
    mkdir -p "$(dirname "$dest")"
    cat >"$dest" <<'PY'
"""M2EX non-Steam shortcut.

Updates run on the host via the Steam launch wrapper. This file only
marks the prefix so CachyOS Proton does not skip localfixes.
"""

from protonfixes.logger import log


def main() -> None:
    log.info("M2EX prefix ready (vcrun2022 + host m2ex wrapper)")
PY
    : >>"$(dirname "$dest")/__init__.py"
    rm -f "$(vanilla_protonfix_path)"
    log "installed Proton hook at $dest"
}

remove_protonfix() {
    rm -f "$(protonfix_path)" "$(vanilla_protonfix_path)"
}

find_proton_bin() {
    local name="$PROTON_TOOL" candidate
    for candidate in \
        "/usr/share/steam/compatibilitytools.d/$name/proton" \
        "$STEAM_ROOT/compatibilitytools.d/$name/proton"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    die "Proton tool '$name' not found under /usr/share/steam/compatibilitytools.d or $STEAM_ROOT/compatibilitytools.d. Set M2EX_PROTON."
}

cmd_setup_prefix() {
    local appid prefix proton
    need_cmd protontricks
    appid="$(shortcut_appid)"
    prefix="$STEAM_ROOT/steamapps/compatdata/$appid"
    proton="$(find_proton_bin)"
    mkdir -p "$prefix"
    log "creating Proton prefix $prefix"
    STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
        STEAM_COMPAT_DATA_PATH="$prefix" \
        "$proton" run wineboot --init >/dev/null 2>&1 || true
    log "installing vcrun2022 into prefix $appid (this can take a few minutes)"
    WINEDEBUG="-all" WINETRICKS_LATEST_VERSION_CHECK="disabled" \
        protontricks --no-bwrap "$appid" -q vcrun2022
    log "vcrun2022 installed"
}

cmd_hook_steam() {
    local restart=0 appid
    m2ex_installed || die "install M2EX first (m2ex update --force)"
    if ensure_steam_stopped; then
        restart=1
    fi
    set_vanilla_launch_options ""
    appid="$(write_m2ex_shortcut)"
    set_compat_tool "$appid" "$PROTON_TOOL"
    install_protonfix
    log "added non-Steam shortcut '$SHORTCUT_NAME' (appid $appid) with Proton $PROTON_TOOL"
    local prefix="$STEAM_ROOT/steamapps/compatdata/$appid"
    if [[ -f "$prefix/pfx/drive_c/windows/system32/msvcp140.dll" ]]; then
        log "vcrun2022 already present; skipping prefix setup"
    else
        cmd_setup_prefix
    fi
    if [[ $restart -eq 1 ]]; then
        start_steam
        sleep 8
    fi
    log "Play M2EX from your Steam library (not the vanilla Medieval II entry)"
}

cmd_unhook_steam() {
    local restart=0
    if ensure_steam_stopped; then
        restart=1
    fi
    remove_m2ex_shortcut
    remove_protonfix
    set_vanilla_launch_options ""
    log "removed M2EX shortcut; vanilla Medieval II is unchanged"
    if [[ $restart -eq 1 ]]; then
        start_steam
    fi
}

campaign_mod() {
    case "${1:-}" in
        ""|vanilla|grand|imperial) printf '' ;;
        americas) printf '%s\n' '--features.mod=mods/americas' ;;
        britannia|british|british_isles) printf '%s\n' '--features.mod=mods/british_isles' ;;
        crusades) printf '%s\n' '--features.mod=mods/crusades' ;;
        teutonic) printf '%s\n' '--features.mod=mods/teutonic' ;;
        *) die "unknown campaign: $1 (vanilla, americas, britannia, crusades, teutonic)" ;;
    esac
}

cmd_launch() {
    local extra runid
    extra="$(campaign_mod "${1:-}")"
    runid="$(shortcut_runid)"
    if [[ -n "$extra" ]]; then
        exec steam "steam://rungameid/${runid}//${extra}"
    fi
    exec steam "steam://rungameid/${runid}"
}

looks_like_steam_command() {
    local arg
    for arg in "$@"; do
        local lower="${arg,,}"
        case "$lower" in
            steamlaunch|waitforexitandrun|*proton*|*medieval2.exe*|*kingdoms.exe*|*m2ex.exe*|*steam-launch-wrapper*)
                return 0
                ;;
        esac
    done
    return 1
}

main() {
    mkdir -p "$CACHE_DIR" "$STATE_DIR"

    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    case "$1" in
        help|-h|--help) usage ;;
        *)
            resolve_paths
            case "$1" in
                check) shift; cmd_check "$@" ;;
                update) shift; cmd_update "$@" ;;
                status) shift; cmd_status "$@" ;;
                hook-steam) shift; cmd_hook_steam "$@" ;;
                unhook-steam) shift; cmd_unhook_steam "$@" ;;
                setup-prefix) shift; cmd_setup_prefix "$@" ;;
                launch) shift; cmd_launch "$@" ;;
                *)
                    if looks_like_steam_command "$@"; then
                        cmd_wrap_launch "$@"
                    else
                        die "unknown command: $1 (try m2ex help)"
                    fi
                    ;;
            esac
            ;;
    esac
}

main "$@"
