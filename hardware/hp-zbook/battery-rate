#!/usr/bin/env python3
"""Publish a synthetic BAT0 rate and state for HP ZBooks whose EC misreports.

Two separate lies from the same EC, one for each direction of current:

Discharging. ACPI _BST Battery Present Rate is 0xFFFFFFFF (Unknown). The
kernel still creates current_now because the battery reports mA units, but
reads return ENODEV. omarchy-battery-status treats the file as usable,
overwrites UPower's energy-rate, and the power panel shows 0W.

Charging. current_now reads, and is a sawtooth: the EC pulse-charges, ramping
0 -> ~2.9A over ~12s, dropping out, and repeating, with BAT0/status
alternating Charging / Not charging across the cycle. Measured over 98s on a
14u G6, the mean of current_now x voltage_now (15.8W) matches the charge
counter's own integral (15.8W) exactly -- so the EC is not lying about the
instant, but any single sample lands anywhere in 0-44.6W, and the panel
samples every 5s. UPower turns the "Not charging" half of the cycle into
state: pending-charge, which the power panel reads as a hold at a charge
limit; this machine has no charge_control_* at all. That half of the fix is
lib/monarchy/overlay-power.py.

So the rate here is always the charge counter's, averaged over a window that
spans several pulses, in both directions. An earlier version handed off to
the kernel tree whenever current_now merely read, which meant the smoothing
this file exists for was off for the whole of every charge.

The tree also carries a synthetic `status`. The kernel's flips twice a minute
while charging normally, and a consumer dividing energy by rate needs to know
which way to count. Charging/Discharging/Not charging/Full keep their kernel
meanings -- the value is smoothed, not redefined. Everything else
(charge/energy now and full, voltage, cycle_count) is a symlink to sysfs.

current_now is deliberately absent from the tree. omarchy-battery-status
falls back to current_now x voltage_now when power_now is missing, and
mirroring it would hand that path either the ENODEV or the sawtooth.
"""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

WINDOW_S = 60.0
# Two full pulse cycles. Below that the window can sit entirely inside one
# ramp or one drop-out and the answer is the sawtooth again.
MIN_DT_S = 30.0
INTERVAL_S = 2.0
# A pack that is not moving still wobbles: charge_now steps in whole mAh, which
# at this pack's voltage is ~11 mWh, and a step either way inside a 60s window
# reads as 0.7W. Anything under 1.5W is that wobble, not a rate and not a
# direction. A real charge is 15W here and a trickle that genuinely sits below
# the floor has no useful time to full left to print anyway.
MIN_RATE_UW = 1_500_000

# t, charge uAh, energy uWh, voltage uV. A pack has charge units or energy
# units, not both, so one of the middle two is None.
Sample = tuple[float, "int | None", "int | None", "int | None"]

# Kernel attributes mirrored into the synthetic tree alongside power_now and
# status. They are what a consumer needs to turn the rate into a time
# remaining: charge/energy now and full, and the voltage that converts charge
# to energy. cycle_count is just the panel's "Charge cycles" row. Whichever
# names this pack does not have are skipped.
MIRRORED = (
    "charge_now",
    "charge_full",
    "energy_now",
    "energy_full",
    "voltage_now",
    "cycle_count",
)


def env_path(name: str, default: str) -> Path:
    return Path(os.environ.get(name, default))


def read_int(path: Path) -> int | None:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def read_text(path: Path) -> str:
    try:
        return path.read_text().strip()
    except OSError:
        return ""


def sample_battery(bat: Path, now: float) -> Sample | None:
    """(t, charge uAh, energy uWh, voltage uV). Whichever units the pack has."""
    charge = read_int(bat / "charge_now")
    energy = read_int(bat / "energy_now")
    if charge is None and energy is None:
        return None
    return now, charge, energy, read_int(bat / "voltage_now")


def ac_online(sys_ac: Path) -> bool:
    return read_text(sys_ac / "online") == "1"


def delta_uwh(first: Sample, last: Sample) -> int | None:
    """Energy that moved between two samples, in microwatt-hours.

    A charge-reporting pack has its *delta* converted, never its two absolute
    readings. voltage_now swings ~0.3V across a charge pulse on this EC, and
    0.3V against a 1.2Ah pack is 0.36Wh of pure artefact -- larger than the
    0.26Wh a minute the pack is actually taking on, and it read as 68W before
    this was written the other way round.
    """
    _, c0, e0, v0 = first
    _, c1, e1, v1 = last
    if e0 is not None and e1 is not None:
        return e1 - e0
    if c0 is None or c1 is None or v0 is None or v1 is None:
        return None
    return int((c1 - c0) * ((v0 + v1) / 2.0) / 1_000_000)


def counter(sample: Sample) -> int | None:
    """Whichever of the two counters this pack keeps."""
    _, charge, energy, _ = sample
    return energy if energy is not None else charge


def record(steps: list[Sample], sample: Sample) -> list[Sample]:
    """Keep a sample only when the counter has actually moved.

    charge_now does not tick smoothly: it sits still and then jumps a few mAh,
    every ~15s while charging. First-and-last-sample over a fixed window
    therefore measures a whole number of jumps across a span that does not
    line up with them, which on a 60s window is a +-25% error on the rate --
    measured against the counter's own integral, 14.3-31.2W for a pack drawing
    20.6W. First-and-last-*jump* measures the same energy over the span it
    actually took, and the only error left is when the jump was noticed.
    """
    if steps and counter(steps[-1]) == counter(sample):
        return steps
    steps.append(sample)
    return steps


def rate_from_samples(steps: list[Sample]) -> tuple[int, int] | None:
    """(magnitude uW, signed delta uWh) across the window, or None if unknown."""
    if len(steps) < 2:
        return None
    dt = steps[-1][0] - steps[0][0]
    if dt < MIN_DT_S:
        return None
    delta = delta_uwh(steps[0], steps[-1])
    if delta is None:
        return None
    return int(abs(delta) * 3600.0 / dt), delta


def rate_now(steps: list[Sample], now: float) -> tuple[int, int] | None:
    """The rate as of `now`, or None while there is nothing to say.

    A counter that has not moved in a whole window is a pack that is not
    moving: held at a limit, full, or idle on the charger. That is a rate of
    zero, which is an answer, not the absence of one.
    """
    rate = rate_from_samples(steps)
    if rate is None and steps and now - steps[-1][0] >= WINDOW_S:
        return 0, 0
    return rate


def smooth_status(kernel_status: str, ac: bool, rate: tuple[int, int] | None) -> str:
    """The direction the pack is actually going.

    Discharging is the one state this EC never gets wrong -- it is not
    reported while the charger is attached -- so it is taken at its word. On
    AC the kernel flag is the unreliable one and the counter decides.
    """
    if kernel_status == "Discharging":
        return "Discharging"
    if not ac or rate is None:
        return kernel_status or "Unknown"
    power_uw, delta = rate
    if delta > 0 and power_uw >= MIN_RATE_UW:
        return "Charging"
    if kernel_status == "Full":
        return "Full"
    return "Not charging"


def compute_from_stdin() -> int:
    """Samples in, `power_uw status` out. What the tests drive.

    `t charge_uAh voltage_uV` for a charge-reporting pack, `t energy_uWh` for
    an energy-reporting one.
    """
    samples: list[Sample] = []
    last_seen = 0.0
    kernel_status = os.environ.get("ZBOOK_STATUS", "Charging")
    ac = os.environ.get("ZBOOK_AC", "1") == "1"
    for line in sys.stdin:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) == 3:
            sample = (float(parts[0]), int(parts[1]), None, int(parts[2]))
        else:
            sample = (float(parts[0]), None, int(parts[1]), None)
        samples = record(samples, sample)
        # When the counter last moved and when it was last *looked at* are
        # different questions, and staleness is the second one.
        last_seen = sample[0]
    rate = rate_now(samples, last_seen)
    status = smooth_status(kernel_status, ac, rate)
    if rate is None:
        print(f"- {status}")
        return 1
    power_uw, _ = rate
    if power_uw < MIN_RATE_UW:
        power_uw = 0
    print(f"{power_uw} {status}")
    return 0


def ensure_tree(runtime: Path, sys_bat: Path, sys_ac: Path) -> Path:
    tree = runtime / "power_supply"
    bat = tree / "BAT0"
    if bat.is_symlink():
        bat.unlink()
    bat.mkdir(parents=True, exist_ok=True)
    ac_link = tree / "AC"
    if sys_ac.exists():
        if ac_link.is_symlink() or ac_link.exists():
            ac_link.unlink()
        ac_link.symlink_to(sys_ac)
    for name in MIRRORED:
        target = sys_bat / name
        link = bat / name
        if link.is_symlink() or link.exists():
            link.unlink()
        if target.exists():
            link.symlink_to(target)
    # status is written, not linked: see the module docstring. A leftover
    # symlink from an older install would otherwise be written through.
    status = bat / "status"
    if status.is_symlink():
        status.unlink()
    return bat


def write_file(path: Path, text: str) -> None:
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    tmp.replace(path)


def publish(bat: Path, runtime: Path, power_uw: int | None, status: str) -> None:
    write_file(bat / "status", f"{status}\n")
    if power_uw is None:
        return
    write_file(bat / "power_now", f"{power_uw}\n")
    write_file(runtime / "watts", f"{power_uw / 1_000_000.0:.1f}\n")


def prune(steps: list[Sample], now: float) -> list[Sample]:
    """Drop what has aged out, but never the latest reading.

    How long ago the counter last moved is itself the answer for a pack that
    is not moving at all, and dropping it would leave nothing to say that
    with.
    """
    kept = [s for s in steps if s[0] >= now - WINDOW_S]
    return kept if kept else steps[-1:]


def loop() -> int:
    sys_bat = env_path("ZBOOK_SYS_BAT", "/sys/class/power_supply/BAT0")
    sys_ac = env_path("ZBOOK_SYS_AC", "/sys/class/power_supply/AC")
    runtime = env_path("ZBOOK_RUNTIME", "/run/zbook-battery")
    runtime.mkdir(parents=True, exist_ok=True)

    bat = ensure_tree(runtime, sys_bat, sys_ac)
    write_file(runtime / "mode", "synthetic\n")
    samples: list[Sample] = []
    last_ac: bool | None = None

    while True:
        if not bat.is_dir():
            bat = ensure_tree(runtime, sys_bat, sys_ac)

        now = time.time()
        ac = ac_online(sys_ac)
        # Plugging in or pulling out reverses the sign mid-window. Averaging
        # across that point describes neither side of it.
        if ac != last_ac:
            samples = []
            last_ac = ac

        sample = sample_battery(sys_bat, now)
        if sample is not None:
            samples = prune(record(samples, sample), now)

        rate = rate_now(samples, now)
        status = smooth_status(read_text(sys_bat / "status"), ac, rate)
        power_uw: int | None = None
        if rate is not None:
            power_uw = rate[0] if rate[0] >= MIN_RATE_UW else 0
        publish(bat, runtime, power_uw, status)

        time.sleep(INTERVAL_S)


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("--compute", "-c"):
        return compute_from_stdin()
    if len(sys.argv) > 1:
        print("usage: battery-rate [--compute]", file=sys.stderr)
        return 2
    try:
        return loop()
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
