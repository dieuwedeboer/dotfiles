#!/bin/bash
# Apply Dieuwe's monarchy prefs on top of Omarchy.
# Vars live in ~/.config/environment.d/monarchy.conf (not fish local):
#   MONARCHY_FONT_PT_OFFSET  points added to Omarchy's 12px -> 9pt mapping
#   MONARCHY_ALPHA           background opacity for foot/alacritty/emacs (e.g. 0.88)
# Drop an executable in font-size.d/ or alpha.d/; they receive the value as $1.
set -euo pipefail

usage() {
  echo "Usage: apply-font-size [--print]"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

MONARCHY_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/monarchy.conf"

monarchy_var() {
  local key=$1
  if [[ -n ${!key+x} ]]; then
    printf '%s\n' "${!key}"
    return 0
  fi
  [[ -f $MONARCHY_CONF ]] || return 1
  awk -F= -v key="$key" '
    $1 ~ "^[[:space:]]*" key "[[:space:]]*$" {
      v = $2
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      print v
      exit
    }
  ' "$MONARCHY_CONF"
}

run_hooks() {
  local dir=$1
  local val=$2
  [[ -d $dir ]] || return 0
  local hook
  for hook in "$dir"/*; do
    [[ -f $hook ]] || continue
    [[ $hook == *.sample ]] && continue
    bash "$hook" "$val" || echo "Hook failed: $hook" >&2
  done
}

offset=$(monarchy_var MONARCHY_FONT_PT_OFFSET || true)
[[ $offset =~ ^[+-]?[0-9]+$ ]] || offset=0

px=12
shell_config="$HOME/.config/omarchy/shell.toml"
if [[ -f $shell_config ]]; then
  v=$(awk '
    /^[[:space:]]*\[/ { in_font = ($0 ~ /^[[:space:]]*\[font\]([[:space:]]|$)/); next }
    in_font && /^[[:space:]]*base-size[[:space:]]*=/ {
      v = $0
      sub(/^[^=]*=[[:space:]]*/, "", v)
      sub(/[[:space:]]*(#.*)?$/, "", v)
      print v
      exit
    }
  ' "$shell_config")
  [[ $v =~ ^[0-9]+$ ]] && px=$v
fi

omarchy_pt=$(awk -v s="$px" 'BEGIN { printf "%d", int(s * 9 / 12 + 0.5) }')
pt=$((omarchy_pt + offset))
((pt < 1)) && pt=1

alpha=$(monarchy_var MONARCHY_ALPHA || true)
[[ $alpha =~ ^[0-9]+(\.[0-9]+)?$ ]] || alpha=

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
mkdir -p "$state_dir"
printf '%s\n' "$pt" >"$state_dir/font-pt"
if [[ -n $alpha ]]; then
  printf '%s\n' "$alpha" >"$state_dir/alpha"
fi

if [[ ${1:-} == --print ]]; then
  printf '%s\n' "$pt"
  exit 0
fi

run_hooks "$HOME/.config/omarchy/hooks/font-size.d" "$pt"
if [[ -n $alpha ]]; then
  run_hooks "$HOME/.config/omarchy/hooks/alpha.d" "$alpha"
fi
