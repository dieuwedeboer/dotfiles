#!/usr/bin/env bash
# Install and wrap M2EX as Medieval II (Steam app 4700).
# Set the game's launch options to: m2ex %command%
set -euo pipefail

VANILLA_APP_ID=4700
REPO="Pannoniae/rex"
ASSET_NAME="M2EX.7z"
EXE_NAME="M2EX.exe"
SHORTCUT_NAME="M2EX"
PROTON_TOOL="${M2EX_PROTON:-proton-cachyos-slr}"

script_path() {
    readlink -f "${BASH_SOURCE[0]}"
}

launch_wrapper() {
    printf '%s %%command%%\n' "$(script_path)"
}

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/m2ex"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/m2ex"
RELEASES_URL="https://api.github.com/repos/${REPO}/releases"
USER_AGENT="m2ex-updater (+https://github.com/${REPO})"
GAME_DIR=""
EXE_PATH=""
VERSION_FILE=""

if [[ -n "${STEAM_DIR:-}" ]]; then
    STEAM_ROOT="$STEAM_DIR"
elif [[ -e "$HOME/.steam/steam" ]]; then
    STEAM_ROOT="$(readlink -f "$HOME/.steam/steam")"
else
    STEAM_ROOT="$HOME/.local/share/Steam"
fi

usage() {
    cat <<'EOF'
Usage: m2ex <command> [args]
       m2ex %command%

Commands:
  check         Compare the installed build with the latest GitHub test release
  update        Install the latest test release if it is newer
  update --force
                Reinstall even if the tag matches
  status        Show install path, version, and 4700 wrap state
  hook          Point Medieval II at this wrapper, force Proton, remove the
                old non-Steam shortcut
  uninstall     Remove M2EX.exe and the 4700 launch-option wrap
  launch [mod]  Start Medieval II through Steam (vanilla, americas, britannia,
                crusades, teutonic)
  help          Show this help

Put this in Medieval II's launch options:

  m2ex %command%

Steam still shows Definitive / Americas / Britannia / Crusades / Teutonic.
This wrapper updates M2EX if needed, then swaps medieval2.exe for M2EX.exe.

The game directory is read from Steam's libraryfolders.vdf for app 4700.
Updates prefer GitHub prereleases. Discord-only drops are not scraped.

Environment:
  M2EX_GAME_DIR      Override the game install path
  M2EX_PROTON        Compatibility tool name (default proton-cachyos-slr)
  STEAM_DIR          Override the Steam root
  M2EX_SKIP_UPDATE=1 Skip the GitHub check when wrapping a Steam launch
EOF
}

log() { printf 'm2ex: %s\n' "$*"; }
warn() { printf 'm2ex: warning: %s\n' "$*" >&2; }
die() { printf 'm2ex: %s\n' "$*" >&2; exit 1; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

# Steam's runtime pins an old libcurl. Host tools (curl, 7z) must not see it.
run_host() {
    env -u LD_PRELOAD -u LD_LIBRARY_PATH -u STEAM_RUNTIME \
        -u STEAM_ZENITY -u PRESSURE_VESSEL_FILESYSTEMS_RO \
        "$@"
}

discover_game_dir() {
    local libfile="$STEAM_ROOT/steamapps/libraryfolders.vdf"
    [[ -f "$libfile" ]] || die "Steam library list not found at $libfile"
    python3 - "$STEAM_ROOT" "$VANILLA_APP_ID" <<'PY'
import sys
from pathlib import Path
import vdf

steam_root = Path(sys.argv[1])
appid = str(sys.argv[2])
libfile = steam_root / "steamapps" / "libraryfolders.vdf"
data = vdf.loads(libfile.read_text(errors="replace"))
folders = data.get("libraryfolders") or {}
found = None
for folder in folders.values():
    if not isinstance(folder, dict):
        continue
    path = folder.get("path")
    if not path:
        continue
    lib = Path(path)
    apps = {str(k) for k in (folder.get("apps") or {})}
    acf = lib / "steamapps" / f"appmanifest_{appid}.acf"
    if appid in apps or acf.exists():
        found = lib
        break
if found is None:
    sys.exit(2)
acf = found / "steamapps" / f"appmanifest_{appid}.acf"
installdir = "Medieval II Total War"
if acf.exists():
    state = vdf.loads(acf.read_text(errors="replace"))
    installdir = state.get("AppState", {}).get("installdir") or installdir
print(found / "steamapps" / "common" / installdir)
PY
}

resolve_paths() {
    if [[ -n "$GAME_DIR" ]]; then
        return 0
    fi
    if [[ -n "${M2EX_GAME_DIR:-}" ]]; then
        GAME_DIR="$M2EX_GAME_DIR"
    else
        local discovered
        if ! discovered="$(discover_game_dir)"; then
            die "Medieval II (app $VANILLA_APP_ID) is not in any Steam library. Install it or set M2EX_GAME_DIR."
        fi
        GAME_DIR="$discovered"
    fi
    EXE_PATH="$GAME_DIR/$EXE_NAME"
    VERSION_FILE="$GAME_DIR/m2ex.version"
}

installed_tag() {
    if [[ -f "$VERSION_FILE" ]]; then
        tr -d '[:space:]' <"$VERSION_FILE"
    fi
}

game_ready() {
    [[ -d "$GAME_DIR" && -f "$GAME_DIR/medieval2.exe" ]]
}

m2ex_installed() {
    [[ -f "$EXE_PATH" ]]
}

prefix_dir() {
    printf '%s\n' "$STEAM_ROOT/steamapps/compatdata/$VANILLA_APP_ID"
}

vcrun_present() {
    local prefix
    prefix="$(prefix_dir)"
    [[ -f "$prefix/pfx/drive_c/windows/system32/msvcp140.dll" \
        && -f "$prefix/pfx/drive_c/windows/system32/mfc140.dll" ]]
}

# M2EX is 64-bit MFC. Proton will not search system32 for mfc140 unless
# the DLL sits next to the exe or the override is native.
ensure_mfc_next_to_exe() {
    local src dll
    src="$(prefix_dir)/pfx/drive_c/windows/system32"
    for dll in mfc140.dll mfc140u.dll; do
        if [[ -f "$src/$dll" && ! -f "$GAME_DIR/$dll" ]]; then
            cp -- "$src/$dll" "$GAME_DIR/$dll"
            log "copied $dll next to $EXE_NAME"
        fi
    done
}

cache_name_for_tag() {
    local tag="$1"
    printf 'M2EX-%s.7z' "${tag//\//-}"
}

userdata_dir() {
    local cfg
    cfg="$(find_localconfig)"
    dirname "$(dirname "$cfg")"
}

shortcuts_path() {
    printf '%s\n' "$(userdata_dir)/config/shortcuts.vdf"
}

fetch_latest() {
    need_cmd curl
    need_cmd jq
    local json
    if ! json="$(run_host curl -fsSL --max-time 15 -A "$USER_AGENT" "$RELEASES_URL")"; then
        warn "GitHub releases request failed"
        return 1
    fi
    local chosen
    chosen="$(jq -c --arg n "$ASSET_NAME" '
        def has_asset: ([.assets[].name] | index($n)) != null;
        ( [.[] | select(.draft == false and .prerelease == true and has_asset)] | first )
        // ( [.[] | select(.draft == false and has_asset)] | first )
        // empty
    ' <<<"$json")"
    if [[ -z "$chosen" ]]; then
        warn "no GitHub release contains $ASSET_NAME"
        return 1
    fi
    local tag url digest size channel
    tag="$(jq -er '.tag_name' <<<"$chosen")"
    url="$(jq -er --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | .browser_download_url' <<<"$chosen")"
    digest="$(jq -r --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | (.digest // empty)' <<<"$chosen")"
    size="$(jq -er --arg n "$ASSET_NAME" '.assets[] | select(.name == $n) | .size' <<<"$chosen")"
    if [[ "$(jq -er '.prerelease' <<<"$chosen")" == "true" ]]; then
        channel="test"
    else
        channel="stable"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$tag" "$url" "$digest" "$size" "$channel"
}

sha256_file() {
    sha256sum "$1" | awk '{print $1}'
}

verify_digest() {
    local file="$1" digest="$2"
    [[ -z "$digest" || "$digest" == "null" ]] && return 0
    local expected="${digest#sha256:}"
    local actual
    actual="$(sha256_file "$file")"
    [[ "$actual" == "$expected" ]]
}

download_asset() {
    local url="$1" dest="$2" digest="$3"
    mkdir -p "$(dirname "$dest")"
    local tmp="${dest}.part"
    if ! run_host curl -fL --retry 3 --retry-delay 2 -A "$USER_AGENT" -o "$tmp" "$url"; then
        rm -f "$tmp"
        return 1
    fi
    if ! verify_digest "$tmp" "$digest"; then
        rm -f "$tmp"
        warn "checksum mismatch for $ASSET_NAME"
        return 1
    fi
    mv -f "$tmp" "$dest"
}

extract_archive() {
    local archive="$1"
    need_cmd 7z
    game_ready || die "Medieval II install not found at $GAME_DIR"
    [[ -f "$archive" ]] || { warn "archive missing: $archive"; return 1; }
    if ! run_host 7z x -y -aoa -o"$GAME_DIR" "$archive" >/dev/null; then
        warn "7z extract failed for $archive"
        return 1
    fi
    [[ -f "$EXE_PATH" ]] || { warn "extract finished but $EXE_NAME is missing"; return 1; }
}

clear_wine_virtual_desktop() {
    local reg
    reg="$(prefix_dir)/pfx/user.reg"
    [[ -f "$reg" ]] || return 0
    python3 - "$reg" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
text = path.read_text(errors="replace")
new = re.sub(
    r'\n\[Software\\\\Wine\\\\Explorer\][^\n]*\n(?:#[^\n]*\n)?(?:\"Desktop\"=\"[^\"]*\"\n)?',
    "\n",
    text,
    count=1,
)
new = re.sub(
    r'\n\[Software\\\\Wine\\\\Explorer\\\\Desktops\][^\n]*\n(?:#[^\n]*\n)?(?:\"Default\"=\"[^\"]*\"\n)?',
    "\n",
    new,
    count=1,
)
if new != text:
    path.write_text(new)
    sys.exit(0)
sys.exit(0)
PY
}

current_launch_options() {
    python3 - "$(find_localconfig)" "$VANILLA_APP_ID" <<'PY'
import re, sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(errors="replace")
app_id = sys.argv[2]
pattern = re.compile(
    rf'("{re.escape(app_id)}"\n(?P<indent>\t+){{)(?P<body>.*?)(\n(?P=indent)}})',
    re.S,
)
for m in pattern.finditer(text):
    body = m.group("body")
    if '"LastPlayed"' in body or '"LaunchOptions"' in body or f'"{app_id}_eula_' in body:
        opt = re.search(r'"LaunchOptions"\t+"(.*)"', body)
        print(opt.group(1) if opt else "")
        break
PY
}

cmd_status() {
    local tag
    tag="$(installed_tag)"
    printf 'Game dir:     %s\n' "$GAME_DIR"
    printf 'Game exe:     %s\n' "$(game_ready && echo present || echo missing)"
    printf 'M2EX exe:     %s\n' "$(m2ex_installed && echo present || echo missing)"
    printf 'Installed:    %s\n' "${tag:-none}"
    printf 'Launch wrap:  %s\n' "$(launch_wrapper)"
    printf '4700 options: %s\n' "$(current_launch_options || true)"
    local prefix
    prefix="$(prefix_dir)"
    if [[ -d "$prefix/pfx" ]]; then
        printf 'Prefix:       %s\n' "$prefix"
        printf 'vcrun2022:    %s\n' "$(vcrun_present && echo present || echo missing)"
    else
        printf 'Prefix:       not created yet\n'
    fi
    local leftovers
    leftovers="$(leftover_shortcut_appids || true)"
    if [[ -n "$leftovers" ]]; then
        printf 'Old shortcut: %s (run m2ex hook to remove)\n' "$leftovers"
    fi
}

cmd_check() {
    local tag url digest size channel installed latest
    installed="$(installed_tag)"
    if ! latest="$(fetch_latest)"; then
        printf 'Installed: %s\n' "${installed:-none}"
        printf 'Latest:    unknown (GitHub query failed)\n'
        return 1
    fi
    IFS=$'\t' read -r tag url digest size channel <<<"$latest"
    printf 'Installed: %s\n' "${installed:-none}"
    printf 'Latest:    %s (%s)\n' "$tag" "$channel"
    if [[ -n "$installed" && "$installed" == "$tag" ]]; then
        printf 'Status:    up to date\n'
        return 0
    fi
    printf 'Status:    update available\n'
    return 2
}

cmd_update() {
    local force=0
    if [[ "${1:-}" == "--force" ]]; then
        force=1
    elif [[ -n "${1:-}" ]]; then
        die "unknown update option: $1"
    fi

    game_ready || die "Medieval II install not found at $GAME_DIR"

    local tag url digest size channel installed latest
    installed="$(installed_tag)"
    if ! latest="$(fetch_latest)"; then
        return 1
    fi
    IFS=$'\t' read -r tag url digest size channel <<<"$latest"
    if [[ -z "$tag" || -z "$url" ]]; then
        warn "GitHub release parse failed"
        return 1
    fi
    log "latest GitHub $channel release is $tag"

    if [[ $force -eq 0 && -n "$installed" && "$installed" == "$tag" && -f "$EXE_PATH" ]]; then
        log "already on $tag"
        return 0
    fi

    local archive="$CACHE_DIR/$(cache_name_for_tag "$tag")"
    if [[ -f "$archive" ]] && ! verify_digest "$archive" "$digest"; then
        warn "cached archive failed checksum, re-downloading"
        rm -f "$archive"
    fi
    if [[ ! -f "$archive" ]]; then
        log "downloading $ASSET_NAME ($tag)"
        download_asset "$url" "$archive" "$digest" || return 1
    else
        log "using cached $archive"
    fi

    log "installing $tag into $GAME_DIR"
    extract_archive "$archive" || return 1
    printf '%s\n' "$tag" >"$VERSION_FILE"
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$tag" >"$STATE_DIR/installed"
    log "installed $tag"
}

rewrite_steam_command() {
    local -a out=()
    local arg replaced=0
    for arg in "$@"; do
        local base="${arg##*/}"
        local lower="${base,,}"
        if [[ "$lower" == "medieval2.exe" || "$lower" == "kingdoms.exe" || "$lower" == "m2ex.exe" ]]; then
            local exe="$arg"
            [[ "$lower" != "m2ex.exe" ]] && exe="$EXE_PATH"
            out+=("$exe")
            replaced=1
        else
            out+=("$arg")
        fi
    done
    if [[ $replaced -eq 0 ]]; then
        die "Steam command did not contain M2EX.exe, medieval2.exe, or kingdoms.exe. Set Medieval II's compatibility tool to Proton."
    fi
    printf '%s\0' "${out[@]}"
}

maybe_update_for_launch() {
    if [[ "${M2EX_SKIP_UPDATE:-}" == "1" ]]; then
        return 0
    fi
    if ! cmd_update; then
        if m2ex_installed; then
            warn "update failed; launching the installed M2EX"
        else
            die "M2EX is not installed and the update failed"
        fi
    fi
}

cmd_wrap_launch() {
    [[ $# -gt 0 ]] || die "missing Steam command"
    maybe_update_for_launch
    m2ex_installed || die "$EXE_NAME is not installed in $GAME_DIR"
    if ! vcrun_present; then
        warn "vcrun2022/mfc140 not found in prefix $(prefix_dir). Run: m2ex hook"
    fi
    ensure_mfc_next_to_exe
    clear_wine_virtual_desktop
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}mfc140=n,b;mfc140u=n,b"

    local -a rewritten=()
    mapfile -d '' -t rewritten < <(rewrite_steam_command "$@")
    if [[ "${M2EX_DEBUG:-}" == "1" ]]; then
        {
            printf 'IN\n'
            printf '  %q\n' "$@"
            printf 'OUT\n'
            printf '  %q\n' "${rewritten[@]}"
        } >"$STATE_DIR/last-wrap.log"
        export PROTON_LOG=1
        export PROTON_LOG_DIR="$STATE_DIR"
    fi
    exec "${rewritten[@]}"
}

find_localconfig() {
    local found=()
    local p
    for p in "$STEAM_ROOT"/userdata/*/config/localconfig.vdf; do
        [[ -f "$p" ]] && found+=("$p")
    done
    if [[ ${#found[@]} -eq 0 ]]; then
        die "could not find Steam userdata/localconfig.vdf"
    fi
    if [[ ${#found[@]} -gt 1 ]]; then
        warn "multiple Steam userconfigs found; using ${found[0]}"
    fi
    printf '%s\n' "${found[0]}"
}

steam_is_running() {
    local pid
    pid="$(cat "$HOME/.steam/steam.pid" 2>/dev/null || true)"
    if [[ -n "$pid" && -r "/proc/$pid/cmdline" ]]; then
        tr '\0' ' ' <"/proc/$pid/cmdline" | grep -q 'ubuntu12_32/steam'
        return $?
    fi
    return 1
}

wait_for_steam_exit() {
    local i
    for i in $(seq 1 90); do
        steam_is_running || return 0
        sleep 1
    done
    return 1
}

wait_for_steam_start() {
    local i
    for i in $(seq 1 60); do
        steam_is_running && return 0
        sleep 1
    done
    return 1
}

ensure_steam_stopped() {
    if steam_is_running; then
        log "shutting Steam down so config changes persist"
        steam -shutdown >/dev/null 2>&1 || true
        if ! wait_for_steam_exit; then
            die "Steam is still running; close it and retry"
        fi
        return 0
    fi
    return 1
}

start_steam() {
    log "starting Steam"
    nohup steam >/dev/null 2>&1 &
    disown || true
    wait_for_steam_start || warn "Steam did not come back within 60s"
}

set_launch_options() {
    local value="$1"
    local cfg
    cfg="$(find_localconfig)"
    python3 - "$cfg" "$VANILLA_APP_ID" "$value" <<'PY'
import re, sys
from pathlib import Path

cfg = Path(sys.argv[1])
app_id = sys.argv[2]
value = sys.argv[3]
text = cfg.read_text(errors="replace")
pattern = re.compile(
    rf'("{re.escape(app_id)}"\n(?P<indent>\t+){{)(?P<body>.*?)(\n(?P=indent)}})',
    re.S,
)
matches = list(pattern.finditer(text))
app_matches = [
    m for m in matches
    if '"LastPlayed"' in m.group("body")
    or '"LaunchOptions"' in m.group("body")
    or f'"{app_id}_eula_' in m.group("body")
]
if not app_matches:
    sys.exit("could not find app %s in localconfig.vdf" % app_id)
m = app_matches[0]
indent = m.group("indent") + "\t"
body = re.sub(r'\n\t+"LaunchOptions"\t+".*?"', "", m.group("body"))
if value:
    body += f'\n{indent}"LaunchOptions"\t\t"{value}"'
new = f'{m.group(1)}{body}{m.group(4)}'
if new == m.group(0):
    sys.exit(0)
cfg.write_text(text[: m.start()] + new + text[m.end() :])
PY
}

set_compat_tool() {
    local appid="$1" tool="$2"
    local cfg="$STEAM_ROOT/config/config.vdf"
    python3 - "$cfg" "$appid" "$tool" <<'PY'
import re, sys
from pathlib import Path

cfg = Path(sys.argv[1])
appid, tool = sys.argv[2], sys.argv[3]
text = cfg.read_text(errors="replace")
if re.search(rf'"{re.escape(appid)}"\s*\n\s*\{{[\s\S]*?"name"\s*"{re.escape(tool)}"', text):
    sys.exit(0)
block = (
    f'\t\t\t\t\t"{appid}"\n'
    f'\t\t\t\t\t{{\n'
    f'\t\t\t\t\t\t"name"\t\t"{tool}"\n'
    f'\t\t\t\t\t\t"config"\t\t""\n'
    f'\t\t\t\t\t\t"priority"\t\t"250"\n'
    f'\t\t\t\t\t}}\n'
)
text = re.sub(
    rf'\t\t\t\t\t"{re.escape(appid)}"\n\t\t\t\t\t\{{.*?\n\t\t\t\t\t\}}\n',
    "",
    text,
    count=1,
    flags=re.S,
)
text, n = re.subn(
    r'("CompatToolMapping"\n\t\t\t\t\{\n)',
    r'\1' + block,
    text,
    count=1,
)
if n != 1:
    sys.exit("could not find CompatToolMapping in config.vdf")
cfg.write_text(text)
PY
}

remove_compat_tool() {
    local appid="$1"
    local cfg="$STEAM_ROOT/config/config.vdf"
    [[ -f "$cfg" ]] || return 0
    python3 - "$cfg" "$appid" <<'PY'
import re, sys
from pathlib import Path

cfg = Path(sys.argv[1])
appid = sys.argv[2]
text = cfg.read_text(errors="replace")
new, n = re.subn(
    rf'\t\t\t\t\t"{re.escape(appid)}"\n\t\t\t\t\t\{{.*?\n\t\t\t\t\t\}}\n',
    "",
    text,
    count=1,
    flags=re.S,
)
if n:
    cfg.write_text(new)
PY
}

leftover_shortcut_appids() {
    local path
    path="$(shortcuts_path)"
    [[ -f "$path" ]] || return 0
    python3 - "$path" "$SHORTCUT_NAME" "${EXE_PATH:-}" <<'PY'
import sys
from pathlib import Path
import vdf

path = Path(sys.argv[1])
name, exe = sys.argv[2], sys.argv[3]
exe_field = f'"{exe}"' if exe else ""
if not path.exists() or path.stat().st_size == 0:
    sys.exit(0)
data = vdf.binary_loads(path.read_bytes(), raise_on_remaining=False)
for item in data.get("shortcuts", {}).values():
    lower = {str(k).lower(): v for k, v in item.items()}
    if lower.get("appname") == name or (exe_field and lower.get("exe") == exe_field):
        appid = int(lower.get("appid") or 0)
        if appid < 0:
            appid += 1 << 32
        print(appid)
PY
}

remove_m2ex_shortcut() {
    local path
    path="$(shortcuts_path)"
    [[ -f "$path" ]] || return 0
    python3 - "$path" "$SHORTCUT_NAME" "${EXE_PATH:-}" <<'PY'
import sys
from pathlib import Path
import vdf

path = Path(sys.argv[1])
name, exe = sys.argv[2], sys.argv[3]
exe_field = f'"{exe}"' if exe else ""
if not path.exists() or path.stat().st_size == 0:
    sys.exit(0)
data = vdf.binary_loads(path.read_bytes(), raise_on_remaining=False)
shortcuts = {str(k): v for k, v in data.get("shortcuts", {}).items()}
keep = {}
idx = 0
removed = 0
for item in shortcuts.values():
    lower = {str(k).lower(): v for k, v in item.items()}
    if lower.get("appname") == name or (exe_field and lower.get("exe") == exe_field):
        removed += 1
        continue
    keep[str(idx)] = item
    idx += 1
if removed:
    path.write_bytes(vdf.binary_dumps({"shortcuts": keep}))
    print(removed)
PY
}

remove_shortcut_artefacts() {
    local appid userdata
    userdata="$(userdata_dir)"
    while IFS= read -r appid; do
        [[ -n "$appid" ]] || continue
        log "removing leftover non-Steam shortcut $appid"
        remove_compat_tool "$appid"
        rm -f "$userdata/config/librarycache/${appid}.json"
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/protonfixes/localfixes/${appid}.py"
        local old_prefix="$STEAM_ROOT/steamapps/compatdata/$appid"
        local new_prefix
        new_prefix="$(prefix_dir)"
        if [[ -d "$old_prefix" ]]; then
            if [[ ! -d "$new_prefix" ]]; then
                log "moving Proton prefix $appid -> $VANILLA_APP_ID"
                mv "$old_prefix" "$new_prefix"
            else
                log "removing leftover prefix $old_prefix"
                rm -rf "$old_prefix"
            fi
        fi
    done < <(leftover_shortcut_appids || true)
    remove_m2ex_shortcut >/dev/null || true
    rm -f "$userdata/config/localconfig.vdf.m2ex.bak"
    rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/protonfixes/localfixes/${VANILLA_APP_ID}.py"
}

find_proton_bin() {
    local name="$PROTON_TOOL" candidate
    for candidate in \
        "/usr/share/steam/compatibilitytools.d/$name/proton" \
        "$STEAM_ROOT/compatibilitytools.d/$name/proton"
    do
        if [[ -x "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    die "Proton tool '$name' not found. Set M2EX_PROTON."
}

cmd_setup_prefix() {
    local prefix proton
    need_cmd protontricks
    prefix="$(prefix_dir)"
    proton="$(find_proton_bin)"
    mkdir -p "$prefix"
    log "creating Proton prefix $prefix"
    STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT" \
        STEAM_COMPAT_DATA_PATH="$prefix" \
        "$proton" run wineboot --init >/dev/null 2>&1 || true
    if vcrun_present; then
        log "vcrun2022 already present"
        return 0
    fi
    log "installing vcrun2022 into prefix $VANILLA_APP_ID (this can take a few minutes)"
    WINEDEBUG="-all" WINETRICKS_LATEST_VERSION_CHECK="disabled" \
        protontricks --no-bwrap "$VANILLA_APP_ID" -q vcrun2022
    log "vcrun2022 installed"
}

cmd_hook() {
    local restart=0
    if [[ ! -f "$EXE_PATH" ]]; then
        cmd_update
    fi
    m2ex_installed || die "install M2EX first (m2ex update --force)"
    if ensure_steam_stopped; then
        restart=1
    fi
    remove_shortcut_artefacts
    set_compat_tool "$VANILLA_APP_ID" "$PROTON_TOOL"
    set_launch_options "$(launch_wrapper)"
    clear_wine_virtual_desktop
    ensure_mfc_next_to_exe
    if vcrun_present; then
        log "vcrun2022 already present in prefix $VANILLA_APP_ID"
    else
        cmd_setup_prefix
    fi
    if [[ $restart -eq 1 ]]; then
        start_steam
        sleep 8
    fi
    log "Medieval II launch options set to: $(launch_wrapper)"
    log "Play Medieval II from Steam. Campaigns use the normal Play menu."
}

cmd_uninstall() {
    if [[ "${1:-}" == "--yes" ]]; then
        shift || true
    elif [[ -t 0 ]]; then
        read -r -p "Remove M2EX.exe and the 4700 wrap? [y/N] " ans
        case "$ans" in
            y|Y|yes|YES) ;;
            *) echo "Aborted."; return 1 ;;
        esac
    else
        die "uninstall needs --yes when not interactive"
    fi

    local restart=0
    if ensure_steam_stopped; then
        restart=1
    fi
    remove_shortcut_artefacts
    set_launch_options ""
    if [[ -n "$EXE_PATH" ]]; then
        rm -f "$EXE_PATH" "$GAME_DIR/M2EX.xdb" "$VERSION_FILE" \
            "$GAME_DIR/mfc140.dll" "$GAME_DIR/mfc140u.dll"
    fi
    rm -rf "$STATE_DIR"
    log "removed M2EX. Verify Medieval II files in Steam if you want stock data back."
    if [[ $restart -eq 1 ]]; then
        start_steam
    fi
}

campaign_mod() {
    case "${1:-}" in
        ""|vanilla|grand|imperial) printf '' ;;
        americas) printf '%s\n' '--features.mod=mods/americas' ;;
        britannia|british|british_isles) printf '%s\n' '--features.mod=mods/british_isles' ;;
        crusades) printf '%s\n' '--features.mod=mods/crusades' ;;
        teutonic) printf '%s\n' '--features.mod=mods/teutonic' ;;
        *) die "unknown campaign: $1 (vanilla, americas, britannia, crusades, teutonic)" ;;
    esac
}

cmd_launch() {
    local extra
    extra="$(campaign_mod "${1:-}")"
    if [[ -n "$extra" ]]; then
        exec steam "steam://rungameid/${VANILLA_APP_ID}//${extra}"
    fi
    exec steam "steam://rungameid/${VANILLA_APP_ID}"
}

looks_like_steam_command() {
    local arg
    for arg in "$@"; do
        local lower="${arg,,}"
        case "$lower" in
            steamlaunch|waitforexitandrun|*proton*|*medieval2.exe*|*kingdoms.exe*|*m2ex.exe*|*steam-launch-wrapper*|*medieval2.sh*)
                return 0
                ;;
        esac
    done
    return 1
}

main() {
    mkdir -p "$CACHE_DIR" "$STATE_DIR"

    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    case "$1" in
        help|-h|--help) usage ;;
        *)
            resolve_paths
            case "$1" in
                check) shift; cmd_check "$@" ;;
                update) shift; cmd_update "$@" ;;
                status) shift; cmd_status "$@" ;;
                hook|hook-steam) shift; cmd_hook "$@" ;;
                uninstall|unhook-steam) shift; cmd_uninstall "$@" ;;
                setup-prefix) shift; cmd_setup_prefix "$@" ;;
                launch) shift; cmd_launch "$@" ;;
                *)
                    if looks_like_steam_command "$@"; then
                        cmd_wrap_launch "$@"
                    else
                        die "unknown command: $1 (try m2ex help)"
                    fi
                    ;;
            esac
            ;;
    esac
}

main "$@"
