pkgname=hyprbars-monarchy
pkgver=0
pkgrel=1
pkgdesc="hyprbars title bars, built against the installed Hyprland"
arch=('x86_64')
url='https://github.com/hyprwm/hyprland-plugins'
license=('BSD-3-Clause')
depends=('hyprland')
makedepends=('git' 'pkgconf')
source=('hyprland-plugins::git+https://github.com/hyprwm/hyprland-plugins.git')
sha256sums=('SKIP')

_hyprland_commit() {
  Hyprland --version | sed -n '1s/.* at commit \([0-9a-f]\{40\}\).*/\1/p'
}

pkgver() {
  pacman -Q hyprland | awk '{ gsub("-", "_", $2); print $2 }'
}

prepare() {
  local commit pin
  commit=$(_hyprland_commit)
  [ -n "$commit" ] || { echo "could not read the Hyprland commit from Hyprland --version" >&2; return 1; }
  pin=$(grep -F "\"$commit\"" hyprland-plugins/hyprpm.toml | grep -o '[0-9a-f]\{40\}' | sed -n 2p)
  [ -n "$pin" ] || { echo "hyprland-plugins has no pin for Hyprland $commit" >&2; return 1; }
  git -C hyprland-plugins checkout --quiet "$pin"
}

build() {
  make -C hyprland-plugins/hyprbars all
}

package() {
  install -Dm755 hyprland-plugins/hyprbars/hyprbars.so "$pkgdir/usr/lib/hyprland-plugins/hyprbars.so"
  install -Dm644 hyprland-plugins/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
